# --- Database ---
# Local development default credentials only; production takes DATABASE_URL from the deployment environment.
# Postgres (production/local docker):
DATABASE_URL=postgresql+psycopg2://skillgap:skillgap@localhost:5432/skillgap
# SQLite (lightweight local dev — uncomment to use instead):
# DATABASE_URL=sqlite:///./data/skillgap_dev.db

# --- App ---
# development | test | production. Production refuses DEBUG=true, SQLite and wildcard CORS (validated at startup).
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Explicit browser origins allowed to call the API. Outside production any http://localhost:<port> is also allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_URL=http://localhost:8000
# Schema management: empty = create_all only outside production; production always uses `alembic upgrade head`.
AUTO_CREATE_SCHEMA=

# --- Semantic model (optional; the system runs in SAFE_MODE without it) ---
# Overrides engine_config.json. A different MODEL_NAME is a different cache key (recorded decisions are not reused).
OLLAMA_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:7b-instruct

# --- Pipeline / analysis thresholds (Section 36 of spec: no magic numbers in code) ---
SKILL_MATCH_THRESHOLD=0.75
PARTIAL_COVERAGE_THRESHOLD=0.4
HIGH_DEMAND_THRESHOLD=0.15
HIGH_COVERAGE_THRESHOLD=0.15
MIN_PERIODS_FOR_TREND=2
MIN_ELIGIBLE_POSTINGS_PER_PERIOD=30
MIN_SKILL_POSTINGS_FOR_TREND=5
EMERGING_SKILL_GROWTH_THRESHOLD=0.20
DECLINING_SKILL_GROWTH_THRESHOLD=-0.20
DRIFT_THRESHOLD=0.10
NEAR_DUPLICATE_SIMILARITY_THRESHOLD=0.75

# --- Model / pipeline versioning (Section 37/42) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=1
TAXONOMY_VERSION=ESCO-v1.2.1
PIPELINE_VERSION=0.1.0

# --- File upload limits (Section 39) ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_CURRICULUM_EXTENSIONS=.pdf,.txt

# --- Jooble (job posting source, India) ---
# Obtain a free key at https://jooble.org/api/about -- NEVER commit a real value here.
# Loaded from the environment only; never hardcoded in source, tests, fixtures, or logs.
JOOBLE_API_KEY=
JOOBLE_API_BASE_URL=https://in.jooble.org/api
