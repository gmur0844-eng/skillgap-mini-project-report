{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human semantic-validation decision (one reviewed item)",
  "description": "Written by scripts/review/ingest_human_review.py to data/human_validation/<version>/decisions.jsonl. Only a person sets human_label; the model output is stored beside it, never copied into it. A decision is evidence about a MAPPING, never about what a source document contains.",
  "type": "object",
  "required": ["review_id", "split", "item_kind", "left_text", "right_text", "model_relationship", "model_relationship_code",
               "human_label", "reviewer", "verdict", "model_version", "dataset_version", "evidence_class"],
  "properties": {
    "review_id": {"type": "string", "pattern": "^v[0-9]+-[0-9]{3}$"},
    "split": {"enum": ["DEVELOPMENT", "VALIDATION", "FINAL_TEST"]},
    "item_kind": {"enum": ["TOPIC_TO_REFERENCE_TOPIC", "TOPIC_TO_CONCEPT", "TOPIC_TO_SKILL", "DRIFT_CONCEPT", "JOB_MENTION_TO_ESCO"]},
    "left_text": {"type": "string"}, "left_context": {"type": "string"},
    "right_text": {"type": "string"}, "right_context": {"type": "string"},
    "original_evidence": {"type": "object", "description": "uids of the source records the item was built from"},
    "model_relationship": {"type": "string", "description": "frozen model output as shown to the reviewer"},
    "model_relationship_code": {"enum": ["SAME_CONCEPT", "PARENT", "CHILD", "RELATED", "PARTIAL_OVERLAP", "UNRELATED", "AMBIGUOUS", "INSUFFICIENT_EVIDENCE"]},
    "model_similarity": {"type": ["number", "null"], "description": "uncalibrated similarity; not confidence"},
    "human_label": {"enum": ["SAME_CONCEPT", "PARENT", "CHILD", "RELATED", "PARTIAL_OVERLAP", "UNRELATED", "AMBIGUOUS", "INSUFFICIENT_EVIDENCE"],
                    "description": "options A-H of the review file; letters are expanded on ingest"},
    "human_note": {"type": ["string", "null"]},
    "human_error_category": {"type": ["string", "null"]},
    "reviewer": {"type": "string", "minLength": 1},
    "review_timestamp": {"type": ["string", "null"]},
    "ingested_at": {"type": "string"},
    "verdict": {"enum": ["CORRECT", "INCORRECT", "ALTERNATIVE", "AMBIGUOUS", "INSUFFICIENT_EVIDENCE"],
                "description": "derived from human_label vs model_relationship_code"},
    "error_category": {"type": ["string", "null"], "enum": [null, "lexical false positive", "unrelated match / lexical false positive",
                       "word-sense error", "parent/child reversal", "overly broad concept", "overly narrow concept",
                       "missed semantic match", "relationship type error"]},
    "model_version": {"type": "object", "required": ["run_id", "code_fingerprint", "config_hash", "pipeline_version"]},
    "dataset_version": {"type": "string"},
    "evidence_class": {"const": "HUMAN_VALIDATION (about the mapping; not source evidence)"}
  }
}
