{
 "version": "semantic-form-responses-v1",
 "form_title": "Semantic Relationship Validation — Curriculum Intelligence",
 "package": "semantic_gold/computer-science-and-engineering/v1",
 "benchmark": {
  "path": "data/evaluation/semantic_benchmark_v1/benchmark.json",
  "sha256": "94b4e79c49bc2c7a0c5bce0234298f9ebada568c1e767ee8651aac19ac3722b7"
 },
 "output_columns": [
  {
   "name": "case_id",
   "from": "the reference in the question title 'Case <n> (Ref. <case_id>) — …'",
   "join": "benchmark_id of the frozen benchmark; model outputs are joined on it later, outside the form"
  },
  {
   "name": "reviewer_id",
   "from": "the 'Reviewer ID' answer (pseudonymous; no name or email is collected)"
  },
  {
   "name": "relationship_label",
   "from": "'Case <n> (Ref. <case_id>) — Relationship'",
   "mapping": {
    "A — Same concept": "SAME_CONCEPT",
    "B — Parent / broader concept": "PARENT",
    "C — Child / more specific concept": "CHILD",
    "D — Related": "RELATED",
    "E — Partial overlap": "PARTIAL_OVERLAP",
    "F — Unrelated": "UNRELATED",
    "G — Ambiguous": "AMBIGUOUS",
    "H — Insufficient evidence": "INSUFFICIENT_EVIDENCE"
   }
  },
  {
   "name": "confidence",
   "from": "'Case <n> (Ref. <case_id>) — Confidence'",
   "mapping": {
    "High": "HIGH",
    "Moderate": "MODERATE",
    "Low": "LOW"
   }
  },
  {
   "name": "reasoning",
   "from": "'Case <n> (Ref. <case_id>) — Optional reasoning' (empty when not given)"
  },
  {
   "name": "timestamp",
   "from": "the 'Timestamp' column Google Forms adds to every response"
  }
 ],
 "one_row_per": "reviewer × case",
 "expected_rows_per_reviewer": 48,
